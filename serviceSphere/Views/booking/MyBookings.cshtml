@model IEnumerable<serviceSphere.sp_my_bookings_Result>

@{
    ViewBag.Title = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .booking-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.12);
        margin-bottom: 25px;
        overflow: hidden;
    }

    .booking-header {
        background: #000;
        color: #fff;
        padding: 15px 20px;
    }

    .booking-body {
        padding: 20px;
    }

    .booking-info {
        margin-bottom: 10px;
    }

    .status-badge {
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .pending {
        background: #ffc107;
        color: #000;
    }

    .accepted {
        background: #28a745;
        color: white;
    }

    .rejected {
        background: #dc3545;
        color: white;
    }

    .completed {
        background: #007bff;
        color: white;
    }

    .review-btn {
        border-radius: 8px;
        font-weight: 600;
    }

    .page-title {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 700;
    }
</style>

<div class="container" style="margin-top:120px; margin-bottom:50px;">

    <h2 class="page-title">
        My Bookings
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No bookings found.
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="booking-card">

            <div class="booking-header">
                <h4 style="margin:0;">
                    @item.service_name
                </h4>
            </div>

            <div class="booking-body">

                <div class="row">

                    <div class="col-md-6">

                        <div class="booking-info">
                            <strong>Date :</strong>
                            @Convert.ToDateTime(item.service_date).ToString("dd-MM-yyyy")
                        </div>

                        <div class="booking-info">
                            <strong>Time :</strong>
                            @item.service_time
                        </div>

                    </div>

                    <div class="col-md-6 text-right">

                        @if (item.status == "Pending")
                        {
                            <span class="status-badge pending">
                                Pending
                            </span>
                        }
                        else if (item.status == "Accepted")
                        {
                            <span class="status-badge accepted">
                                Accepted
                            </span>
                        }
                        else if (item.status == "Rejected")
                        {
                            <span class="status-badge rejected">
                                Rejected
                            </span>
                        }
                        else if (item.status == "Completed")
                        {
                            <span class="status-badge completed">
                                Completed
                            </span>
                        }

                    </div>

                </div>

                <hr />



                <div class="booking-info">
                    <strong>Address :</strong> @item.address
                </div>

                <div class="booking-info">
                    <strong>Description :</strong> @item.description
                </div>






                @if (item.status == "Completed")
                {
                    <hr />

                    <div class="text-center">

                        <a href="@Url.Action(
                            "AddReview",
                            "Review",
                            new
                            {
                                booking_id = item.booking_id,
                                service_id = item.service_id
                            })"
                           class="btn btn-warning review-btn">

                            ⭐ Add Review

                        </a>

                    </div>
                }

            </div>

        </div>
    }

</div>