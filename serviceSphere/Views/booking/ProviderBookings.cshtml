@model IEnumerable<serviceSphere.sp_provider_bookings_Result>

@{
    ViewBag.Title = "Provider Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .booking-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.12);
        margin-bottom: 25px;
        transition: 0.3s;
    }

        .booking-card:hover {
            transform: translateY(-3px);
        }

    .booking-header {
        background: #000;
        color: white;
        padding: 15px 20px;
        border-radius: 15px 15px 0 0;
    }

    .booking-body {
        padding: 20px;
    }

    .info-row {
        margin-bottom: 10px;
        font-size: 15px;
    }

    .status-badge {
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .pending {
        background: #ffc107;
        color: #000;
    }

    .accepted {
        background: #28a745;
        color: white;
    }

    .rejected {
        background: #dc3545;
        color: white;
    }

    .completed {
        background: #007bff;
        color: white;
    }

    .action-btn {
        min-width: 120px;
        margin-right: 10px;
        border-radius: 8px;
        font-weight: 600;
    }

    .page-title {
        font-weight: 700;
        margin-bottom: 30px;
        text-align: center;
    }
</style>

<div class="container" style="margin-top:120px; margin-bottom:50px;">

    <h2 class="page-title">
        Incoming Service Requests
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No service requests available.
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="booking-card">

            <div class="booking-header">
                <h4 style="margin:0;">
                    @item.service_name
                </h4>
            </div>

            <div class="booking-body">

                <div class="row">

                    <div class="col-md-6">

                        <div class="info-row">
                            <strong>Date :</strong>
                            @Convert.ToDateTime(item.service_date).ToString("dd-MM-yyyy")
                        </div>

                        <div class="info-row">
                            <strong>Time :</strong>
                            @item.service_time
                        </div>

                    </div>

                    <div class="col-md-6 text-md-right">

                        @if (item.status == "Pending")
                        {
                            <span class="status-badge pending">
                                Pending
                            </span>
                        }
                        else if (item.status == "Accepted")
                        {
                            <span class="status-badge accepted">
                                Accepted
                            </span>
                        }
                        else if (item.status == "Rejected")
                        {
                            <span class="status-badge rejected">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="status-badge completed">
                                Completed
                            </span>
                        }

                    </div>

                </div>

                <hr />

                <div class="info-row">
                    <strong>Address :</strong><br />
                    @item.address
                </div>

                <div class="info-row">
                    <strong>Problem Description :</strong><br />
                    @item.description
                </div>

                <hr />

                <div class="text-center">

                    @if (item.status == "Pending")
                    {
                        <a href="@Url.Action("AcceptBooking","Booking", new { booking_id = item.booking_id })"
                           class="btn btn-success action-btn">
                            ✓ Accept
                        </a>

                        <a href="@Url.Action("RejectBooking","Booking", new { booking_id = item.booking_id })"
                           class="btn btn-danger action-btn">
                            ✗ Reject
                        </a>
                    }

                    @if (item.status == "Accepted")
                    {
                        <a href="@Url.Action("CompleteBooking","Booking", new { booking_id = item.booking_id })"
                           class="btn btn-primary action-btn">
                            ✓ Mark Completed
                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>