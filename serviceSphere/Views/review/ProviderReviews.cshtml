@model IEnumerable<serviceSphere.sp_provider_reviews_Result>

@{
    ViewBag.Title = "Customer Reviews";
    Layout = "~/Views/Shared/_ProviderLayout.cshtml";
}

<style>

    .page-title {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 700;
    }

    .review-card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.12);
        margin-bottom: 25px;
        overflow: hidden;
    }

    .review-header {
        background: #000;
        color: #fff;
        padding: 15px 20px;
    }

    .review-body {
        padding: 20px;
    }

    .review-info {
        margin-bottom: 10px;
        font-size: 15px;
    }

    .review-message {
        background: #f8f9fa;
        border-left: 4px solid #000;
        padding: 15px;
        border-radius: 8px;
        margin-top: 10px;
    }

    .stars {
        color: gold;
        font-size: 20px;
    }

    .review-date {
        color: #666;
        font-size: 13px;
    }
</style>

<div class="container" style="margin-top:120px; margin-bottom:50px;">

    <h2 class="page-title">
        Customer Reviews
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No reviews available.
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="review-card">

            <div class="review-header">
                <h4 style="margin:0;">
                    @item.service_name
                </h4>
            </div>

            <div class="review-body">

                <div class="review-info">
                    <strong>User ID :</strong> @item.user_id
                </div>

                <div class="review-info">

                    <strong>Rating :</strong>

                    <span class="stars">
                        @for (int i = 1; i <= item.rating; i++)
                        {
                            @:★
                        }
                    </span>

                    (@item.rating / 5)

                </div>

                <div class="review-message">
                    <strong>Review :</strong><br />
                    @item.review_message
                </div>

                <div class="text-right" style="margin-top:15px;">

                    <span class="review-date">
                        @Convert.ToDateTime(item.created_date).ToString("dd-MM-yyyy")
                    </span>

                </div>

            </div>

        </div>
    }

</div>