@model IEnumerable<serviceSphere.sp_search_services_Result>
@{
    ViewBag.Title = "home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (ViewBag.msg != null)
{
    <div class="alert alert-warning">
        @ViewBag.msg
    </div>
}

@using (Html.BeginForm("search_service", "login", FormMethod.Post))
{
    <div class="row" style="margin-top:30px;">

        <div class="col-md-3">
            <input type="text"
                   name="service_name"
                   class="form-control"
                   placeholder="Service Name"
                   value="@ViewBag.service_name" />
        </div>

        <div class="col-md-3">
            <input type="text"
                   name="provider_name"
                   class="form-control"
                   placeholder="Provider Name"
                   value="@ViewBag.provider_name" />
        </div>

        <div class="col-md-2">
            <input type="text"
                   name="location"
                   class="form-control"
                   placeholder="Location"
                   value="@ViewBag.location" />
        </div>

        <div class="col-md-2">
            <select name="category" class="form-control">
                <option value="">All Categories</option>

                @foreach (var c in ViewBag.categories)
                {
                    if (ViewBag.category == c.catname)
                    {
                        <option value="@c.catname" selected="selected">
                            @c.catname
                        </option>
                    }
                    else
                    {
                        <option value="@c.catname">
                            @c.catname
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-1">
            <input type="submit"
                   value="Search"
                   class="btn btn-primary w-100" />
        </div>

        @if (Session["uid"] != null)
        {
            <div class="col-md-1">
                <a href="@Url.Action("MyBookings","booking")"
                   class="btn btn-success w-100">
                    My Bookings
                </a>
            </div>}

    </div>
}








<div style="margin-top:120px; padding-left:20px; padding-right:20px;">
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No services found.
        </div>}

    <div class="row g-4" style="margin-left:0; margin-right:0;">

        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3" style="padding-left:12px; padding-right:12px;">

                <div class="card shadow-sm h-100"
                     style="border-radius:12px; overflow:hidden;">

                    <img src="@Url.Content(item.service_image)"
                         class="card-img-top"
                         style="height:200px; width:100%; object-fit:cover;" />

                    <div class="card-body d-flex flex-column" style="padding:16px;">

                        <h5 style="font-size:18px; font-weight:600; margin-bottom:10px;">
                            @item.service_name
                        </h5>
                        <p style="font-size:14px; color:#555; margin-bottom:8px;">
                            <b>@item.bussiness_name</b>
                        </p>

                        <p style="font-size:14px; height:45px; overflow:hidden; margin-bottom:10px;">
                            @item.service_description
                        </p>

                        <p style="font-size:14px; margin-bottom:6px;">
                            Rating : ⭐ @item.rating
                        </p>

                        <h6 style="margin-bottom:8px;">
                            <span class="text-success">
                                ₹ @item.service_price
                            </span>
                        </h6>

                        <p style="font-size:14px; margin-bottom:12px;">
                            📍 @item.location
                        </p>

                        <a href="@Url.Action("BookService", "booking", new { service_id = item.service_id, provider_id = item.provider_regid })"
                           class="btn btn-primary btn-sm mt-auto">
                            Book Now
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>